# Dockerfile para Next.js exportado
FROM node:18-alpine

# Crear directorio de trabajo
WORKDIR /app

# Instalar serve globalmente
RUN npm install -g serve

# Copiar los archivos estáticos exportados
COPY out/ /app

# Exponer el puerto 3002
EXPOSE 3002

# Comando para servir la carpeta 'out'
CMD ["serve", "-s", ".", "-l", "3002"]
